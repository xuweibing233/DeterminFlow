{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeterminFlow",
  "version": "1.0.10",
  "identifier": "io.determinflow.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "DeterminFlow Contributors",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../runtime/backend/": "runtime/backend/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "headerImage": "images/nsis-header.bmp",
        "sidebarImage": "images/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/installer-hooks.nsh",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "images/nsis-header.bmp",
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/xuweibing233/DeterminFlow/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0NTQ3RDBFMkY2MjUzNDkKUldSSlUySXZEbjFVNUlwR3FzYmlHRERkRVJpMEZFQlBlbHZDMm8za1V5M1d1YUtpMFZuc0VVT1IK"
    }
  }
}
